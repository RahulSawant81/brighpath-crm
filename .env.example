# ==============================================================================
# BRIGHTPATH CRM — SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in your project root:
#   cp .env.example .env
#
# Retrieve these values from your Supabase Dashboard:
#   Project Settings -> API -> Project URL & Project API Keys
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Client Key (Anon / Publishable)
# IMPORTANT: This key is safe to use in the frontend browser bundle.
# NEVER put your 'service_role' secret key or database password here!
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
